{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://znvk1388-cpu.github.io/doudizhu-screen-coach/schema/layout-preset-v1.json",
  "title": "安卓区域模板 v1（对应 0.6.16 LayoutTemplateDocument）",
  "description": "按实际共享画面归一化。矩形为 [左,上,右,下]；左<右、上<下须由客户端额外检查。导入始终重新核对，不携带牌局、截图或声纹。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "layout"
  ],
  "properties": {
    "format": {
      "const": "doudizhu-screen-layout"
    },
    "version": {
      "const": 1
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rule",
        "hand",
        "plays",
        "counts",
        "referenceAspectRatio"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "rule": {
          "enum": [
            "CLASSIC_54",
            "CLASSIC_CHAIN_54",
            "TEAM_84",
            "TEAM_108"
          ]
        },
        "hand": {
          "$ref": "#/definitions/region"
        },
        "plays": {
          "type": "object"
        },
        "counts": {
          "type": "object"
        },
        "referenceAspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mate": {
          "enum": [
            "SELF",
            "LEFT",
            "RIGHT",
            "OPPOSITE"
          ]
        },
        "first": {
          "enum": [
            "SELF",
            "LEFT",
            "RIGHT",
            "OPPOSITE"
          ]
        },
        "confirmed": {
          "const": false,
          "description": "导入仍须在应用内试识别确认。"
        },
        "chainSameLengthHighWins": {
          "type": "boolean"
        },
        "handRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "playRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "englishJokers": {
          "type": "boolean"
        },
        "controls": {
          "$ref": "#/definitions/region"
        },
        "bottom": {
          "$ref": "#/definitions/region"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule": {
                "enum": [
                  "CLASSIC_54",
                  "CLASSIC_CHAIN_54"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "plays": {
                "$ref": "#/definitions/plays3"
              },
              "counts": {
                "$ref": "#/definitions/counts3"
              },
              "first": {
                "enum": [
                  "SELF",
                  "LEFT",
                  "RIGHT"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "plays": {
                "$ref": "#/definitions/plays4"
              },
              "counts": {
                "$ref": "#/definitions/counts4"
              },
              "mate": {
                "enum": [
                  "LEFT",
                  "RIGHT",
                  "OPPOSITE"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "region": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "[left,top,right,bottom]；还须检查左<右、上<下。"
    },
    "plays3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SELF": {
          "$ref": "#/definitions/region"
        },
        "LEFT": {
          "$ref": "#/definitions/region"
        },
        "RIGHT": {
          "$ref": "#/definitions/region"
        }
      },
      "required": [
        "SELF",
        "LEFT",
        "RIGHT"
      ]
    },
    "counts3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SELF": {
          "$ref": "#/definitions/region"
        },
        "LEFT": {
          "$ref": "#/definitions/region"
        },
        "RIGHT": {
          "$ref": "#/definitions/region"
        }
      },
      "required": [
        "LEFT",
        "RIGHT"
      ]
    },
    "plays4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SELF": {
          "$ref": "#/definitions/region"
        },
        "LEFT": {
          "$ref": "#/definitions/region"
        },
        "RIGHT": {
          "$ref": "#/definitions/region"
        },
        "OPPOSITE": {
          "$ref": "#/definitions/region"
        }
      },
      "required": [
        "SELF",
        "LEFT",
        "RIGHT",
        "OPPOSITE"
      ]
    },
    "counts4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SELF": {
          "$ref": "#/definitions/region"
        },
        "LEFT": {
          "$ref": "#/definitions/region"
        },
        "RIGHT": {
          "$ref": "#/definitions/region"
        },
        "OPPOSITE": {
          "$ref": "#/definitions/region"
        }
      },
      "required": [
        "LEFT",
        "RIGHT",
        "OPPOSITE"
      ]
    }
  }
}
